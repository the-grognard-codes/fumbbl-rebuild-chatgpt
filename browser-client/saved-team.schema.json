    "import":{"allOf":[{"$ref":"#/$defs/header"},{"type":"object","additionalProperties":false,"properties":{"version":{},"type":{},"requestId":{},"operation":{"const":"import"},"document":{"$ref":"#/$defs/document"}},"required":["version","type","requestId","operation","document"]}]},
